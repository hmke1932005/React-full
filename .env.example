# Copy to .env (never commit .env). All values are optional.

# Backend used by the dev/preview proxy (default: the Railway API).
# VITE_API_TARGET=https://full-api-production-084f.up.railway.app

# Base URL for uploaded files if they are NOT served from the same origin.
# VITE_UPLOADS_BASE=

# Meetings live signaling (Laravel Reverb / Pusher protocol).
# Without these the meeting room cannot connect in production.
# VITE_REVERB_APP_KEY=
# VITE_REVERB_HOST=
# VITE_REVERB_PORT=443
# VITE_REVERB_SCHEME=https
